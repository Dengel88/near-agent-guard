# Everything is optional: with no .env the app runs fully offline
# (mock AI screener, mock 1Click, simulated treasury). That is what tests use.

# --- AI (screener + demo agent) -------------------------------------------
LLM_PROVIDER=mock              # mock | gemini | openai (any OpenAI-compatible API, e.g. NEAR AI Cloud)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_API_KEY=
LLM_MODEL=zai-org/GLM-5.1-FP8

# --- NEAR Intents 1Click (cross-chain payouts) ------------------------------
ONECLICK_MODE=mock             # mock | live (real quotes from https://1click.chaindefuser.com)
ONECLICK_API_KEY=              # optional; without it 1Click adds a 0.25% fee

# --- Treasury ------------------------------------------------------------------
EXECUTION_MODE=mock            # mock = simulated transfers | live = real NEAR transactions
TREASURY_NEAR_ACCOUNT=         # an existing NEAR account holding USDC (default in config.yaml)
TREASURY_PRIVATE_KEY=          # ed25519:... full-access or function-call key of that account
NEAR_RPC_URL=https://rpc.mainnet.near.org

# --- Agents --------------------------------------------------------------------
AGENT_KEY_AP_AGENT=            # overrides api_key of agent "ap-agent" in config.yaml

# --- Owner -----------------------------------------------------------------------
OWNER_TOKEN=                   # protects /api/owner/*; empty = open demo (keep it set in live mode)
TELEGRAM_BOT_TOKEN=            # optional: ping the owner when a payment is held
TELEGRAM_CHAT_ID=
PUBLIC_URL=                    # used in Telegram links, e.g. https://agent-guard.vercel.app

# --- Storage -------------------------------------------------------------------
DB_PATH=data/guard.db
TURSO_DATABASE_URL=            # shared libSQL DB for serverless (Vercel)
TURSO_AUTH_TOKEN=
